{
  "name": "codex-dsh-native-p0",
  "version": "0.1.2-preview.1",
  "private": true,
  "type": "module",
  "description": "Optional asynchronous MCP bridge to persistent native DeepSeek Harness sessions",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build-ui.mjs",
    "prestart": "npm run build",
    "start": "node src/server.mjs",
    "pretest": "npm run build && node scripts/build-contract-test.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "native-replay": "node scripts/native-replay.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check-updates": "node scripts/check-updates.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-web": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@shikijs/langs": "4.4.3",
    "@tanstack/react-virtual": "3.14.10",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "immer": "10.1.1",
    "katex": "0.18.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.4.3",
    "simple-icons": "16.31.0",
    "smol-toml": "1.9.1",
    "zod": "4.4.3",
    "zustand": "4.5.7"
