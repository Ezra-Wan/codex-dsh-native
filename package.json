  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.1-rc.2": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.2",
    "esbuild": "0.28.2"
  },
